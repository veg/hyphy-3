{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/veg/hyphy-3/main/schemas/v3/fel.v3.schema.json",
  "title": "HyPhy 3 Fixed Effects Likelihood (FEL) Analysis Schema v3.0",
  "description": "Standardized output schema for HyPhy 3 FEL site-level selection analyses.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "analysis",
    "software",
    "provenance",
    "dataset",
    "phylogeny",
    "model_fits",
    "statistical_tests",
    "site_results"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^3\\.[0-9]+\\.[0-9]+$"
    },
    "analysis": {
      "type": "object",
      "required": ["id", "name", "version", "category", "description"],
      "properties": {
        "id": { "type": "string", "enum": ["fel"] },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["citation"],
            "properties": {
              "citation": { "type": "string" },
              "doi": { "type": "string" },
              "pmid": { "type": "string" }
            }
          }
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "software": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "git_commit": { "type": "string" },
        "build_type": { "type": "string" },
        "compiler": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["invocation", "inputs", "execution"],
      "properties": {
        "invocation": {
          "type": "object",
          "required": ["cli_command"],
          "properties": {
            "cli_command": { "type": "string" },
            "working_directory": { "type": "string" },
            "arguments": { "type": "object" }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "format": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "size_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "execution": {
          "type": "object",
          "required": ["start_time", "end_time", "wall_time_seconds", "cpu_threads"],
          "properties": {
            "start_time": { "type": "string" },
            "end_time": { "type": "string" },
            "wall_time_seconds": { "type": "number", "minimum": 0 },
            "cpu_threads": { "type": "integer", "minimum": 1 },
            "hostname": { "type": "string" },
            "os": { "type": "string" },
            "compiler": { "type": "string" }
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "required": ["taxa_count", "codon_sites", "nucleotide_sites", "unique_patterns", "taxa", "genetic_code"],
      "properties": {
        "taxa_count": { "type": "integer", "minimum": 1 },
        "codon_sites": { "type": "integer", "minimum": 1 },
        "nucleotide_sites": { "type": "integer", "minimum": 3 },
        "unique_patterns": { "type": "integer", "minimum": 1 },
        "taxa": {
          "type": "array",
          "items": { "type": "string" }
        },
        "genetic_code": {
          "type": "object",
          "required": ["id", "name", "sense_codons"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "sense_codons": { "type": "integer" },
            "stop_codons": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "partitions": {
          "type": "array"
        }
      }
    },
    "phylogeny": {
      "type": "object",
      "required": ["newick", "nodes", "tree_lengths"],
      "properties": {
        "newick": { "type": "string" },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type", "branch_lengths"],
            "properties": {
              "type": { "type": "string", "enum": ["leaf", "internal"] },
              "branch_lengths": { "type": "object" },
              "model_tags": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "tree_lengths": { "type": "object" }
      }
    },
    "model_fits": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["log_likelihood", "aicc", "parameters_count"],
        "properties": {
          "description": { "type": "string" },
          "log_likelihood": { "type": "number" },
          "aicc": { "type": "number" },
          "parameters_count": { "type": "integer", "minimum": 0 },
          "equilibrium_frequencies": { "type": "object" },
          "substitution_rates": { "type": "object" },
          "global_parameters": { "type": "object" }
        }
      }
    },
    "statistical_tests": {
      "type": "object",
      "required": ["site_level_summary"],
      "properties": {
        "site_level_summary": {
          "type": "object",
          "required": [
            "method",
            "test_statistic",
            "distribution",
            "degrees_of_freedom",
            "null_hypothesis",
            "alternative_hypothesis",
            "threshold",
            "total_sites",
            "diversifying_count",
            "purifying_count",
            "neutral_count"
          ],
          "properties": {
            "method": { "type": "string" },
            "test_statistic": { "type": "string" },
            "distribution": { "type": "string" },
            "degrees_of_freedom": { "type": "integer" },
            "null_hypothesis": { "type": "string" },
            "alternative_hypothesis": { "type": "string" },
            "threshold": { "type": "number" },
            "total_sites": { "type": "integer" },
            "diversifying_count": { "type": "integer" },
            "purifying_count": { "type": "integer" },
            "neutral_count": { "type": "integer" }
          }
        }
      }
    },
    "site_results": {
      "type": "object",
      "required": ["columns", "data"],
      "properties": {
        "columns": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type", "description"],
            "properties": {
              "type": { "type": "string" },
              "unit": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "data": {
          "type": "object",
          "required": ["site", "alpha", "beta", "alpha_null", "lrt", "p_value", "classification"],
          "properties": {
            "site": { "type": "array", "items": { "type": "integer" } },
            "alpha": { "type": "array", "items": { "type": "number" } },
            "beta": { "type": "array", "items": { "type": "number" } },
            "alpha_null": { "type": "array", "items": { "type": "number" } },
            "lrt": { "type": "array", "items": { "type": "number" } },
            "p_value": { "type": "array", "items": { "type": "number" } },
            "total_branch_length": { "type": "array", "items": { "type": "number" } },
            "classification": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
