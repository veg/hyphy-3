    { "name": "SLAC by-site", "method": "slac",
      "json": { "MLE": { "headers": [["ES", ""], ["EN", ""], ["dN-dS", ""]], "content": { "0": { "by-site": { "AVERAGED": [] } } } } } },
    { "name": "FUBAR grid and posterior", "method": "fubar",
      "json": { "grid": [[0.1, 0.1, 0.0]], "posterior": {}, "MLE": { "headers": [["alpha", ""], ["beta", ""], ["beta-alpha", ""]] } } },
    { "name": "Contrast-FEL overall p-value", "method": "contrast-fel",
