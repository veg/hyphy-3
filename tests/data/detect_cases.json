    { "name": "PRIME LogL beside FEL columns", "method": "prime",
      "json": { "MLE": { "headers": [["&alpha;", ""], ["&beta;", ""], ["FEL &beta;", ""], ["PRIME LogL", ""], ["p-value", ""]] } } },
    { "name": "BUSTED unconstrained fit and p-value", "method": "busted",
