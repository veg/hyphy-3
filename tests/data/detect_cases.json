{
  "description": "Shared test vectors for the two method detectors: detect_analysis in include/hyphy/report/html_report.hpp (tests/test_report.cpp) and detectMethod in viz/fel-viewer/src/core/detect-method.js (viz/fel-viewer/tests/detect-method.test.mjs). Each case is a minimal synthetic result JSON and the method both must report; null means unrecognized (the C++ returns an empty string).",
  "cases": [
    { "name": "v3 id", "method": "fel", "json": { "analysis": { "id": "fel" } } },
    { "name": "v3 id is lowercased", "method": "meme", "json": { "analysis": { "id": "MEME" } } },
    { "name": "v3 id with a hyphen", "method": "contrast-fel", "json": { "analysis": { "id": "contrast-fel" } } },
    { "name": "v3 id of a method without a viewer", "method": "busted", "json": { "analysis": { "id": "busted" } } },
    { "name": "v3 id wins over info and layout", "method": "absrel",
      "json": { "analysis": { "id": "absrel", "info": "FEL (Fixed Effects Likelihood)" }, "MLE": { "headers": [["alpha=beta", ""]] } } },

    { "name": "legacy info FEL", "method": "fel", "json": { "analysis": { "info": "FEL (Fixed Effects Likelihood)\n estimates" } } },
    { "name": "legacy info MEME", "method": "meme", "json": { "analysis": { "info": "MEME (Mixed Effects Model of Evolution) estimates" } } },
    { "name": "legacy info SLAC", "method": "slac", "json": { "analysis": { "info": "SLAC (Single Likelihood Ancestor Counting)" } } },
    { "name": "legacy info aBSREL", "method": "absrel", "json": { "analysis": { "info": "aBSREL (Adaptive branch-site random effects likelihood)" } } },
    { "name": "legacy info BUSTED", "method": "busted", "json": { "analysis": { "info": "BUSTED (branch-site unrestricted statistical test of episodic diversification)" } } },
    { "name": "legacy info RELAX", "method": "relax", "json": { "analysis": { "info": "RELAX (a random effects test of selection relaxation)" } } },
    { "name": "legacy info PRIME", "method": "prime", "json": { "analysis": { "info": "PRIME (PRoperty Informed Models of Evolution)" } } },
    { "name": "legacy info Contrast-FEL", "method": "contrast-fel", "json": { "analysis": { "info": "Contrast-FEL (Fixed Effects Likelihood) investigates" } } },
    { "name": "legacy info GARD", "method": "gard", "json": { "analysis": { "info": "GARD : Genetic Algorithms for Recombination" } } },
    { "name": "legacy info FUBAR", "method": "fubar", "json": { "analysis": { "info": "Perform a Fast Unbiased AppRoximate Bayesian (FUBAR) analysis" } } },
    { "name": "legacy info Directional FEL", "method": "dfel", "json": { "analysis": { "info": "Directional FEL detects site-level selection" } } },
    { "name": "legacy info after leading whitespace", "method": "meme", "json": { "analysis": { "info": "\n  MEME estimates" } } },
    { "name": "unknown info falls through to the layout", "method": "fel",
