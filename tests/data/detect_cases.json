      "json": { "MLE": { "headers": { "&alpha;": "", "&beta;<sup>+</sup>": "", "p<sup>+</sup>": "" } } } },
    { "name": "FEL headers, array form", "method": "fel",
      "json": { "MLE": { "headers": [["alpha", ""], ["beta", ""], ["alpha=beta", ""], ["LRT", ""], ["p-value", ""]] } } },
    { "name": "FEL headers, object form", "method": "fel",
      "json": { "MLE": { "headers": { "alpha": "", "beta": "", "alpha=beta": "" } } } },

    { "name": "empty object", "method": null, "json": {} },
    { "name": "unrelated keys", "method": null, "json": { "something": "else" } },
    { "name": "non-string id and info", "method": null, "json": { "analysis": { "id": 7, "info": ["FEL"] } } },
    { "name": "unknown info and no layout", "method": null, "json": { "analysis": { "info": "Something else entirely" } } },
    { "name": "headers of an unknown table", "method": null, "json": { "MLE": { "headers": [["rate", ""], ["weight", ""]] } } },
    { "name": "not an object", "method": null, "json": [1, 2, 3] }
  ]
}
